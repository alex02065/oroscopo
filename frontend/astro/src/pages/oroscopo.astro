---
import Layout from "../layouts/or.astro";
---

<Layout>

  <a href="/">
    <button type="button" id="esci"> <img src="/img/esci.png" alt="Esci" />
    </button>
  </a>

  <button type="button" id="impostazioni">
    <img src="/img/impostazioni.png" alt="Impostazioni" />
  </button>

  <center>
    <h1 id="segno">Seleziona il tuo segno zodiacale</h1>

    <br />

    <form id="oroscopo-form">
      <div class="custom-select">
        <select name="segno" id="select-segno">
          <option value="ariete">Ariete</option>
          <option value="toro">Toro</option>
          <option value="gemelli">Gemelli</option>
          <option value="cancro">Cancro</option>
          <option value="leone">Leone</option>
          <option value="vergine">Vergine</option>
          <option value="bilancia">Bilancia</option>
          <option value="scorpione">Scorpione</option>
          <option value="sagittario">Sagittario</option>
          <option value="capricorno">Capricorno</option>
          <option value="acquario">Acquario</option>
          <option value="pesci">Pesci</option>
        </select>
      </div>

      <button type="submit" id="serch">
        <img src="/img/serch.png" alt="Cerca" />
      </button>

      <div id="pannello-impostazioni" class="modal-impostazioni">
        <div class="modal-content">
          <button type="button" class="chiudi-impostazioni">&times;</button>

          <h2>Impostazioni Oroscopo</h2>
          <hr class="divider" />

          <label>Scegli il sito da cui prendere l'oroscopo</label>

          <center>
            <div class="custom-select">
              <select name="provider" id="select-provider">
                <option value="internazionale">internazionale</option>
                <option value="corriere">corriere</option>
                <option value="sky">sky</option>
                <option value="oggi">oggi</option>
                <option value="AI">AI</option>
              </select>
            </div>
          </center>
        </div>
      </div>
    </form>

    <div id="box-oroscopo" class="box-risultato-oroscopo" style="display:none;">
      <button
        type="button"
        class="chiudi-oroscopo"
        onclick="document.getElementById('box-oroscopo').style.display='none';"
      >
        &times;
      </button>

      <h2 id="titolo-oroscopo">Oroscopo del giorno</h2>
      <p id="testo-oroscopo">Risultato qui (da backend o API)</p>
    </div>
  </center>

  <script>
    const form = document.getElementById('oroscopo-form') as HTMLFormElement;
    const boxOroscopo = document.getElementById('box-oroscopo');
    const titoloOroscopo = document.getElementById('titolo-oroscopo');
    const testoOroscopo = document.getElementById('testo-oroscopo');

    // Logica per l'apertura/chiusura della modale impostazioni (se non l'avevi già scritta altrove)
    const btnImpostazioni = document.getElementById('impostazioni');
    const panelImpostazioni = document.getElementById('pannello-impostazioni');
    const btnChiudiImpostazioni = document.querySelector('.chiudi-impostazioni');

    btnImpostazioni?.addEventListener('click', () => {
      if (panelImpostazioni) panelImpostazioni.style.display = 'block';
    });
    btnChiudiImpostazioni?.addEventListener('click', () => {
      if (panelImpostazioni) panelImpostazioni.style.display = 'none';
    });

    // Gestione dell'invio del Form a Django
    form?.addEventListener('submit', async (e) => {
      e.preventDefault(); // Blocca il ricaricamento della pagina

      const segno = (document.getElementById('select-segno') as HTMLSelectElement).value;
      const provider = (document.getElementById('select-provider') as HTMLSelectElement).value;

      // Mostriamo subito il box con un testo di caricamento
      if (titoloOroscopo) titoloOroscopo.innerText = `Oroscopo: ${segno.toUpperCase()}`;
      if (testoOroscopo) testoOroscopo.innerText = "Recupero dei dati in corso... Attendi...";
      if (boxOroscopo) boxOroscopo.style.display = 'block';

      try {
        // Sostituisci l'URL con l'indirizzo reale del tuo server Django se diverso
        const response = await fetch('http://localhost:8000/recupera_oroscopo/', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ segno: segno, provider: provider })
        });

        const data = await response.json();

        if (response.ok) {
          // Aggiorna il box con i dati reali tornati da Django
          if (titoloOroscopo) titoloOroscopo.innerText = `Oroscopo del ${data.segno}`;
          if (testoOroscopo) testoOroscopo.innerText = data.oroscopo;
        } else {
          if (testoOroscopo) testoOroscopo.innerText = `Errore backend: ${data.errore}`;
        }
      } catch (error) {
        console.error("Errore di connessione:", error);
        if (testoOroscopo) testoOroscopo.innerText = "Impossibile connettersi al server Django. Controlla che sia avviato e che i CORS siano configurati.";
      }
    });
  </script>
</Layout>